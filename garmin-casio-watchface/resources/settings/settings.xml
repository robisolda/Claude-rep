<settings>
    <setting propertyKey="@Properties.Theme" title="@Strings.ThemeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ThemeClassic</listEntry>
            <listEntry value="1">@Strings.ThemeNegative</listEntry>
            <listEntry value="2">@Strings.ThemeGold</listEntry>
            <listEntry value="3">@Strings.ThemeIlluminator</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.ShowGhost" title="@Strings.GhostTitle">
        <settingConfig type="boolean"/>
    </setting>
</settings>
